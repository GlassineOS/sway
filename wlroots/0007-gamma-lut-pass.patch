+bool wlr_gles2_renderer_glassine_set_lut(struct wlr_renderer *wlr_renderer, const uint8_t lut[256]) {
+	struct wlr_gles2_renderer *renderer = gles2_get_renderer(wlr_renderer);
+	struct wlr_egl_context prev_ctx;
+	if (!wlr_egl_make_current(renderer->egl, &prev_ctx)) {
+		return false;
+	}
+	push_gles2_debug(renderer);
+	if (!renderer->glassine_lut.tex) {
+		glGenTextures(1, &renderer->glassine_lut.tex);
+	}
+	glBindTexture(GL_TEXTURE_2D, renderer->glassine_lut.tex);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_LUMINANCE, 256, 1, 0, GL_LUMINANCE, GL_UNSIGNED_BYTE, lut);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	pop_gles2_debug(renderer);
+	bool ok = glGetError() == GL_NO_ERROR;
+	wlr_egl_restore_context(&prev_ctx);
+	return ok;
+}
+
+void wlr_gles2_renderer_glassine_lut_pass(struct wlr_renderer *wlr_renderer, bool on) {
+	gles2_get_renderer(wlr_renderer)->glassine_lut.on = on;
+}
