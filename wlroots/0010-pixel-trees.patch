+bool wlr_fractional_scale_v1_surface_has_object(struct wlr_surface *surface) {
+	struct wlr_addon *addon = wlr_addon_find(&surface->addons,
+		NULL, &fractional_scale_addon_impl);
+	if (addon == NULL) {
+		return false;
+	}
