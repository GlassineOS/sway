+/* Glassine: what to draw of a buffer: src in buffer pixels, dst in output pixels */
+struct px_piece {
+	struct wlr_fbox src;
+	struct wlr_box dst;
+};
+
+static bool px_piece_clip(struct px_piece *piece, const struct wlr_box *clip) {
+	struct wlr_box c;
+	if (!wlr_box_intersection(&c, &piece->dst, clip)) {
+		return false;
+	}
+	double kx = piece->src.width / piece->dst.width;
+	double ky = piece->src.height / piece->dst.height;
+	piece->src.x += (c.x - piece->dst.x) * kx;
+	piece->src.y += (c.y - piece->dst.y) * ky;
+	piece->src.width = c.width * kx;
+	piece->src.height = c.height * ky;
+	piece->dst = c;
+	return true;
+}
