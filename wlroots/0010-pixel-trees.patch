+int32_t wlr_fractional_scale_v1_whole_scale(struct wlr_surface *surface, double scale) {
+	if (wlr_fractional_scale_v1_surface_has_object(surface)) {
+		return ceil(scale);
+	}
+	int32_t n = floor(scale + 0.5);
+	return n < 1 ? 1 : n;
+}
