+static struct wlr_scene_tree *scene_node_px(struct wlr_scene_node *node, int *ux, int *uy) {
+	int x = 0, y = 0;
+	while (node->parent != NULL) {
+		x += node->x;
+		y += node->y;
+		if (node->parent->px_n > 0) {
+			*ux = x;
+			*uy = y;
+			return node->parent;
+		}
+		node = &node->parent->node;
+	}
+	return NULL;
+}
+
+struct wlr_scene_tree *wlr_scene_node_pixel_tree(struct wlr_scene_node *node,
+		int *ux, int *uy) {
+	return scene_node_px(node, ux, uy);
+}
+
+static int px_div_floor(int64_t a, int64_t b) {
+	int64_t q = a / b;
+	if (a % b != 0 && (a < 0) != (b < 0)) {
+		q--;
+	}
+	return (int)q;
+}
+
+/* a units coordinate in layout px from the tree's origin, rounded down / up */
+static int px_lo(const struct wlr_scene_tree *tree, int u) {
+	return px_div_floor((int64_t)u * tree->px_n * 120, tree->px_den);
+}
+
+static int px_hi(const struct wlr_scene_tree *tree, int u) {
+	return -px_div_floor(-(int64_t)u * tree->px_n * 120, tree->px_den);
+}
+
+static bool px_scale_matches(const struct wlr_scene_tree *tree, float scale) {
+	return (int)lroundf(scale * 120) == tree->px_den;
+}
+
+/* The box in output pixels (before the output's transform), on an output of the
+ * given scale at layout ox, oy, of a units box of a pixel tree at layout ax, ay.
+ * True: the output has the tree's scale, a unit is px_n whole pixels. */
+static bool px_dev_box(const struct wlr_scene_tree *tree, int ax, int ay,
+		const struct wlr_box *units, int ox, int oy, float scale, struct wlr_box *dev) {
+	if (px_scale_matches(tree, scale)) {
+		dev->x = (int)round((ax - ox) * scale) + units->x * tree->px_n;
+		dev->y = (int)round((ay - oy) * scale) + units->y * tree->px_n;
+		dev->width = units->width * tree->px_n;
+		dev->height = units->height * tree->px_n;
+		return true;
+	}
+	double k = (double)tree->px_n * 120 / tree->px_den;
+	double x0 = ax - ox + units->x * k, y0 = ay - oy + units->y * k;
+	dev->x = (int)round(x0 * scale);
+	dev->y = (int)round(y0 * scale);
+	dev->width = (int)round((x0 + units->width * k) * scale) - dev->x;
+	dev->height = (int)round((y0 + units->height * k) * scale) - dev->y;
+	return false;
+}
+
+void wlr_scene_tree_set_pixel_units(struct wlr_scene_tree *tree, int n, float scale) {
+	int den = n > 0 ? (int)lroundf(scale * 120) : 0;
+	if (den <= 0) {
+		n = den = 0;
+	}
+	if (tree->px_n == n && tree->px_den == den) {
+		return;
+	}
+
+	int x, y;
+	pixman_region32_t visible;
+	pixman_region32_init(&visible);
+	if (wlr_scene_node_coords(&tree->node, &x, &y)) {
+		scene_node_visibility(&tree->node, &visible);
+	}
+
+	tree->px_n = n;
+	tree->px_den = den;
+	if (n == 0) {
+		tree->px_clip_width = tree->px_clip_height = 0;
+	}
+	scene_node_update(&tree->node, &visible);
+}
+
+void wlr_scene_tree_set_pixel_clip(struct wlr_scene_tree *tree, int width, int height) {
+	if (width <= 0 || height <= 0) {
+		width = height = 0;
+	}
+	if (tree->px_clip_width == width && tree->px_clip_height == height) {
+		return;
+	}
+	tree->px_clip_width = width;
+	tree->px_clip_height = height;
+	scene_node_update(&tree->node, NULL);
+}
