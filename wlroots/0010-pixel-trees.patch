+/* a node below a pixel tree: its opaque region in units, then each rectangle's
+ * edges rounded inwards to whole layout px; x, y: the node's layout position */
+static void scene_node_px_opaque_region(struct wlr_scene_node *node,
+		struct wlr_scene_tree *tree, int ux, int uy, int x, int y,
+		pixman_region32_t *opaque) {
+	int width, height;
+	scene_node_get_raw_size(node, &width, &height);
