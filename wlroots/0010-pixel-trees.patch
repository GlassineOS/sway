+ * source that is a pixel larger loses its last row or column, and one that is a
+ * pixel smaller has its last row or column drawn twice to fill dst. clip: an
+ * output box that cuts every piece. */
+static int px_pieces(const struct wlr_fbox *src, const struct wlr_box *dst,
+		const struct wlr_box *clip, struct px_piece *pieces, bool *exact) {
+	int n = 0;
