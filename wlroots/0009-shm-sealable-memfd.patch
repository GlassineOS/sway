Subject: [PATCH] glassine: shm buffers are memfds that allow sealing

With the pixman renderer, the glassine-epd backend sends the shm allocator's
files to the e-ink panel daemon, which seals each one against shrinking before
it maps it and refuses a file that can't be sealed. allocate_shm_file used
shm_open, which never allows sealing: after a GPU reset sway restarts with
pixman, the daemon refuses every buffer, and the panel stays frozen.
allocate_shm_file now makes a memfd with MFD_ALLOW_SEALING, and falls back to
shm_open where memfd_create fails. The input method's keymap file comes from
the same function; a memfd works there as well.

--- a/util/shm.c
+++ b/util/shm.c
@@ -1,3 +1,4 @@
+#define _GNU_SOURCE   // glassine: memfd_create
 #include <errno.h>
 #include <fcntl.h>
 #include <string.h>
@@ -37,12 +38,18 @@
 }
 
 int allocate_shm_file(size_t size) {
-	char name[] = RANDNAME_PATTERN;
-	int fd = excl_shm_open(name);
+	// glassine: a memfd that allows sealing, so a receiver can seal it against
+	// shrinking before it maps it (the e-ink panel daemon refuses other files);
+	// shm_open where memfd_create is missing
+	int fd = memfd_create("wlroots-shm", MFD_CLOEXEC | MFD_ALLOW_SEALING);
 	if (fd < 0) {
-		return -1;
+		char name[] = RANDNAME_PATTERN;
+		fd = excl_shm_open(name);
+		if (fd < 0) {
+			return -1;
+		}
+		shm_unlink(name);
 	}
-	shm_unlink(name);
 
 	int ret;
 	do {
