diff -ru a/render/gles2/pass.c b/render/gles2/pass.c
--- a/render/gles2/pass.c
+++ b/render/gles2/pass.c
@@ -1,4 +1,5 @@
 #include <stdlib.h>
+#include <string.h>
 #include <assert.h>
 #include <pixman.h>
 #include <time.h>
@@ -8,6 +9,17 @@
 #include "render/gles2.h"
 #include "types/wlr_matrix.h"
 
+/* Glassine: the grey output's formula (glassine_out in the shaders): 2 = luminance
+ * (GLASSINE_EPD_GREY_LUM=1, glassine-session-sway from eink.conf's @grey), else 1 = luma */
+static float glassine_grey_mode(void) {
+	static float m;
+	if (m == 0.0f) {
+		const char *e = getenv("GLASSINE_EPD_GREY_LUM");
+		m = e && *e && strcmp(e, "0") ? 2.0f : 1.0f;
+	}
+	return m;
+}
+
 #define MAX_QUADS 86 // 4kb
 
 static const struct wlr_render_pass_impl render_pass_impl;
@@ -280,7 +292,7 @@
 	pass->prev_ctx = *prev_ctx;
 	struct wlr_dmabuf_attributes dmabuf;
 	pass->grey = wlr_buffer_get_dmabuf(wlr_buffer, &dmabuf) &&
-		dmabuf.format == DRM_FORMAT_R8 ? 1.0f : 0.0f;
+		dmabuf.format == DRM_FORMAT_R8 ? glassine_grey_mode() : 0.0f;
 
 	matrix_projection(pass->projection_matrix, wlr_buffer->width, wlr_buffer->height,
 		WL_OUTPUT_TRANSFORM_FLIPPED_180);
diff -ru a/render/gles2/shaders/quad.frag b/render/gles2/shaders/quad.frag
--- a/render/gles2/shaders/quad.frag
+++ b/render/gles2/shaders/quad.frag
@@ -10,14 +10,28 @@
 
 uniform float grey;
 
-/* Glassine (e-ink): an R8 render target gets the luma, as glassine-epdd-desktop computes it
- * ((77 r + 150 g + 29 b) >> 8 of the 8-bit channels): exact for opaque
- * pixels; luma is linear, so blending grey == the grey of the blend */
+/* Glassine (e-ink): an R8 render target gets the grey value q, as glassine-epdd-desktop
+ * computes it (epd-grey.h). grey 1: luma, (77 r + 150 g + 29 b) >> 8 of the
+ * 8-bit channels: exact for opaque pixels, and linear, so blending grey ==
+ * the grey of the blend. grey 2 (GLASSINE_EPD_GREY_LUM): luminance, the square
+ * root of the sRGB-decoded BT.709 luminance, of the un-premultiplied colour
+ * (then premultiplied again): within a value or two of glassine-epdd-desktop's integer
+ * form; a translucent colour's blend is a little off (not linear) */
 vec4 glassine_out(vec4 c) {
 	if (grey < 0.5) {
 		return c;
 	}
-	float l = floor(dot(floor(c.rgb * 255.0 + 0.5), vec3(77.0, 150.0, 29.0)) / 256.0) / 255.0;
+	float l;
+	if (grey < 1.5) {
+		l = floor(dot(floor(c.rgb * 255.0 + 0.5), vec3(77.0, 150.0, 29.0)) / 256.0) / 255.0;
+	} else {
+		if (c.a <= 0.0) {
+			return vec4(0.0);
+		}
+		vec3 s = floor(clamp(c.rgb / c.a, 0.0, 1.0) * 255.0 + 0.5) / 255.0;
+		vec3 lin = mix(s / 12.92, pow((s + 0.055) / 1.055, vec3(2.4)), step(0.04045, s));
+		l = floor(sqrt(dot(lin, vec3(0.2126, 0.7152, 0.0722))) * 255.0 + 0.5) / 255.0 * c.a;
+	}
 	return vec4(l, l, l, c.a);
 }
 
