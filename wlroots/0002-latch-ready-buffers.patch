+/* GLASSINE_LATCH_LOG=1: trace the fence waits (at error level,
+ * prefix "glassine-latch", so a default sway log keeps them) */
+static int glassine_latch_log = -1;
+static long long glassine_now_ms(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000LL + ts.tv_nsec / 1000000;
+}
+#define GLASSINE_LLOG(...) do { if (glassine_latch_log > 0) wlr_log(WLR_ERROR, "glassine-latch " __VA_ARGS__); } while (0)
